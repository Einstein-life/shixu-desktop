{
  "name": "shixu-desktop-v2",
  "productName": "Shixu Desktop",
  "version": "1.2.1",
  "description": "Local-first research scheduling and wet-lab experiment workflows",
  "main": "electron/main.js",
  "author": "Einstein-life",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "localize": "node scripts/build-locales.cjs",
    "check": "node scripts/check.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never --config.directories.output=win",
    "dist:mac": "node scripts/make-icns.js && electron-builder --mac --publish never --config.directories.output=mac",
    "verify:package": "node scripts/verify-packages.cjs",
    "checksums": "node scripts/release-checksums.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.shixu.desktop.v2",
    "productName": "Shixu Desktop",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "Shixu-Desktop-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "sign": "scripts/sign-mac.cjs",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Shixu-Desktop-${version}-mac-${arch}.${ext}"
    }
  }
}
