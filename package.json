{
  "name": "shixu",
  "productName": "时序调度",
  "version": "1.0.0",
  "description": "时序 · 生信调度与项目进度（桌面版）",
  "main": "electron/main.js",
  "author": "时序",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "node build-prepackaged.js",
    "dist:win": "node build-prepackaged.js",
    "dist:full": "node build-dist.js",
    "dist:mac": "node build-mac.js",
    "dist:all": "node build-mac.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.shixu.desktop",
    "productName": "时序调度",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "时序调度",
      "artifactName": "时序调度-Setup-${version}.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "artifactName": "Shixu-Desktop-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "时序调度",
      "artifactName": "Shixu-Desktop-${version}-mac-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
